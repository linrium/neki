[Unit]
Description=Create containerd devmapper thin pool for Kata Firecracker
Documentation=https://github.com/containerd/containerd/blob/main/docs/snapshotters/devmapper.md
DefaultDependencies=no
Before=containerd.service k3s.service k3s-agent.service
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/kata-fc/devmapper.env
ExecStart=/usr/local/sbin/kata-fc-devmapper-setup

[Install]
WantedBy=multi-user.target
